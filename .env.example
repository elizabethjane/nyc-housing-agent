# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key, used by the agent (agent/agent.py). Create one at
# https://console.anthropic.com/. Also set a monthly spend limit there (LIMIT-7).
ANTHROPIC_API_KEY=

# NY Senate Open Legislation API key, used by sources/snapshot.py to save
# RPP Articles 6-A and 7. Free; register at https://legislation.nysenate.gov/
NYSENATE_API_KEY=

# Kill switch (SPEC.md SEC-5): off, laws-only, or maintenance. Unset means off.
NYCHOUSING_KILL_SWITCH=
